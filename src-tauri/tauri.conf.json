{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentOS Studio",
  "version": "0.10.2",
  "identifier": "dev.konethegreat.agentos-studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AgentOS Studio",
        "width": 1440,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 700,
        "backgroundColor": "#0B0F17"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Multi-agent control plane by K-ONE IT SOLUTIONS",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "K-ONE IT SOLUTIONS",
    "copyright": "Copyright 2026 Kone Tshivhinda, K-ONE IT SOLUTIONS",
    "longDescription": "AgentOS Studio is the native control plane for multi-agent engineering: Hermes, Claude Code, Qoder and Antigravity in one window, with a shared brain, real terminals, projects, skills and a Rust MCP bus. Built by Kone Tshivhinda at K-ONE IT SOLUTIONS.",
    "createUpdaterArtifacts": true,
    "resources": {
      "../docs/GETTING-STARTED.md": "docs/GETTING-STARTED.md",
      "../docs/CHAT.md": "docs/CHAT.md",
      "../docs/GUIDES.md": "docs/GUIDES.md",
      "../docs/AUTOMATIONS.md": "docs/AUTOMATIONS.md",
      "../docs/ROUTING.md": "docs/ROUTING.md"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMyNjhDODQ2MDgyQjM0NDYKUldSR05Dc0lSc2hvd25UL1pGaFd3SVh3QWZ1Q2JxczV3MVd1NllqU0xSellmaHFQdVF3MlhwZlMK",
      "endpoints": [
        "https://github.com/konethegreat/agentos-studio/releases/latest/download/latest.json"
      ]
    }
  }
}
