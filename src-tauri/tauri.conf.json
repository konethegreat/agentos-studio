{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentOS Studio",
  "version": "0.2.0",
  "identifier": "dev.konethegreat.agentos-studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AgentOS Studio",
        "width": 1440,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 700,
        "backgroundColor": "#0B0F17"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Control plane and Rust MCP bus for multi-agent engineering fleets",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
